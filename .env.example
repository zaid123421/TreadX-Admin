# Copy to `.env` (same directory as docker-compose.yml) on the VPS.
# VITE_* values are baked into the client bundle at build time — rebuild after changing them.

# Backend API base URL (include /api/v1)
VITE_API_BASE_URL=https://api.treadx.uqarsoft.com/api/v1

# Extra API debug logging (keep false in production)
VITE_ENABLE_API_DEBUG=false

# Comma-separated 403 body codes that trigger token refresh
VITE_AUTH_REFRESH_403_CODES=TOKEN_EXPIRED,INVALID_TOKEN

# Host port published by Docker (container listens on 80)
HOST_PORT=9000
